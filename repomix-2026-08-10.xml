                options: [
                  { value: "em_espera", label: "Em Espera" },
                  { value: "agendado", label: "Agendado" },
                  { value: "em_producao", label: "Em Produção" },
                  { value: "aguardando_expedicao", label: "Aguardando Expedição" },
