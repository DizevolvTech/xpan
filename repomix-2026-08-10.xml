    true,
  );
  assert.equal(groups[0].label, "Esponja / Pré-fermento");
  assert.deepEqual(
    groups.map((group) => group.rows.map((row) => row.estimatedQuantity)),
    [[1], [4], [2], [1], [2]],
  );
});

