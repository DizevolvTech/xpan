@import "tailwindcss" source(none);
@source "../**/*.{js,jsx,ts,tsx,mdx}";

@theme inline {
  --font-sans: var(--font-sans);
  --font-heading: var(--font-heading);
  --font-mono: var(--font-mono);

  --color-canvas: var(--canvas);
  --color-surface: var(--surface);
  --color-panel: var(--panel);
  --color-panel-foreground: var(--panel-foreground);

  --color-background: var(--background);
  --color-foreground: var(--foreground);

  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);

  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-destructive: var(--destructive);

  --color-info: var(--info);
  --color-info-foreground: var(--info-foreground);
  --color-success: var(--success);
  --color-success-foreground: var(--success-foreground);
  --color-warning: var(--warning);
  --color-warning-foreground: var(--warning-foreground);
  --color-danger: var(--danger);
  --color-danger-foreground: var(--danger-foreground);

  --color-border: var(--border);
  --color-border-strong: var(--border-strong);
  --color-input: var(--input);
  --color-ring: var(--ring);

  --color-sidebar: var(--sidebar);
  --color-sidebar-foreground: var(--sidebar-foreground);
  --color-sidebar-primary: var(--sidebar-primary);
  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);
  --color-sidebar-accent: var(--sidebar-accent);
  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);
  --color-sidebar-border: var(--sidebar-border);
  --color-sidebar-ring: var(--sidebar-ring);

  --radius-sm: calc(var(--radius) - 6px);
  --radius-md: calc(var(--radius) - 3px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
  --radius-2xl: calc(var(--radius) + 10px);

  --shadow-card: var(--shadow-card);
  --shadow-soft: var(--shadow-soft);
  --shadow-popover: var(--shadow-popover);
  --shadow-elevated: var(--shadow-elevated);

  /* UX-0005 — Escala de espaçamento canônica (ritmo 4/8px) — aditiva; UX-0009 consome.
     Namespace `rhythm` (Risco R5): nao colide com a escala numerica default do
     Tailwind 4 (p-2/gap-4 intactos). Mesma arquitetura ancora-derivada de --radius. */
  --spacing-rhythm-3xs: calc(var(--space-unit) * 1);   /*  4px — hairline / gap intra-icone */
  --spacing-rhythm-2xs: calc(var(--space-unit) * 2);   /*  8px — gap rotulo/valor; chip pequeno */
  --spacing-rhythm-xs:  calc(var(--space-unit) * 3);   /* 12px — padding compacto; form denso */
  --spacing-rhythm-sm:  calc(var(--space-unit) * 4);   /* 16px — padding de celula/controle */
  --spacing-rhythm-md:  calc(var(--space-unit) * 6);   /* 24px — padding de card/secao */
  --spacing-rhythm-lg:  calc(var(--space-unit) * 8);   /* 32px — separacao entre blocos */
  --spacing-rhythm-xl:  calc(var(--space-unit) * 12);  /* 48px — separacao entre grandes secoes */
  --spacing-rhythm-2xl: calc(var(--space-unit) * 16);  /* 64px — respiro de topo de pagina */

  /* UX-0005 — Degraus canonicos de opacidade (Estrategia A: 8 degraus).
     Substituem /10 /15 /18 /20 /22 /25 /30 /35 /40 /50 /55 /60 /65 /70 /75 /80 ad-hoc
     via tabela de-para (UX-0009 aplica; UX-0005 so define). Nomes por papel, nao numericos. */
  /* PRECISA ser % — usado como amount em color-mix() via modifier /[var(--opacity-*)].
     Número cru (.10) torna o color-mix inválido → borda cai p/ currentColor (escuro). */
  --opacity-faint:     10%;  /* wash de fundo tonal minimo */
  --opacity-subtle:    16%;  /* fundo de badge/tag tonal */
  --opacity-soft:      22%;  /* fundo tonal de destaque medio */
  --opacity-muted:     25%;  /* wash de bloco informativo */
  --opacity-border:    35%;  /* anel/realce sutil */
  --opacity-divider:   55%;  /* divisor/borda de baixo contraste */
  --opacity-strong:    65%;  /* borda/divisor padrao de card e tabela */
  --opacity-prominent: 78%;  /* borda/texto secundario evidente */
}

:root {
  --radius: 0.9rem;
  --space-unit: 0.25rem; /* UX-0005 — 4px, ancora do ritmo (nao usar direto; via --spacing-rhythm-*) */

  --canvas: oklch(0.975 0.008 85);
  --surface: oklch(0.995 0.002 95);
  --panel: oklch(0.984 0.004 90);
  --panel-foreground: oklch(0.29 0.02 245);

  --background: oklch(0.997 0.001 80);
  --foreground: oklch(0.26 0.02 248);

  --card: oklch(0.998 0.001 85);
  --card-foreground: oklch(0.26 0.02 248);
  --popover: oklch(0.998 0.001 85);
  --popover-foreground: oklch(0.26 0.02 248);

  --primary: oklch(0.44 0.06 238);
  --primary-foreground: oklch(0.985 0.004 90);
  --secondary: oklch(0.94 0.012 80);
  --secondary-foreground: oklch(0.34 0.03 245);
  --muted: oklch(0.95 0.01 85);
  --muted-foreground: oklch(0.49 0.016 245);
  --accent: oklch(0.66 0.12 78);
  --accent-foreground: oklch(0.17 0.01 68);
  --destructive: oklch(0.56 0.2 25);

  --info: oklch(0.84 0.06 238);
  --info-foreground: oklch(0.34 0.05 240);
  --success: oklch(0.86 0.07 148);
  --success-foreground: oklch(0.34 0.05 162);
  --warning: oklch(0.89 0.09 90);
  --warning-foreground: oklch(0.39 0.07 85);
  --danger: oklch(0.9 0.07 20);
  --danger-foreground: oklch(0.43 0.13 22);

  --border: oklch(0.95 0.006 88);
  --border-strong: oklch(0.78 0.02 246);
  --input: oklch(0.96 0.006 84);
  --ring: oklch(0.68 0.08 220);

  --sidebar: oklch(0.94 0.01 88);
  --sidebar-foreground: oklch(0.3 0.02 245);
  --sidebar-primary: oklch(0.44 0.06 238);
  --sidebar-primary-foreground: oklch(0.985 0.004 90);
  --sidebar-accent: oklch(0.92 0.014 80);
  --sidebar-accent-foreground: oklch(0.32 0.03 245);
  --sidebar-border: oklch(0.84 0.013 88);
  --sidebar-ring: oklch(0.68 0.08 220);

  /* UX-0009 — Tokens de cor de estado/marca delegados pela UX-0006 §2.4.
     Valor = OKLCH inline atual, byte-a-byte (UX-0006 §1.5 mediu AA: 6.91-11.04:1).
     Normalizacao, NAO correcao de contraste — nenhum pixel muda. Padrao semantico
     da casa (espelha --success/--success-foreground). Reuso-primeiro: nenhum token
     existente tem o valor exato (L/C divergem de --info/--success/etc.). */
  --status-neutral: oklch(0.94 0.018 255);
  --status-neutral-foreground: oklch(0.42 0.05 255);
  --status-neutral-ring: oklch(0.86 0.03 255);
  --status-neutral-dot: oklch(0.62 0.07 255);

  --status-bake: oklch(0.93 0.06 55);
  --status-bake-foreground: oklch(0.3 0.09 45);
  --status-bake-ring: oklch(0.83 0.1 55);
  --status-bake-dot: oklch(0.62 0.16 45);

  --status-pack: oklch(0.92 0.05 165);
  --status-pack-foreground: oklch(0.33 0.08 165);
  --status-pack-ring: oklch(0.82 0.07 165);
  --status-pack-dot: oklch(0.55 0.12 165);

  --status-hold: oklch(0.94 0.04 295);
  --status-hold-foreground: oklch(0.43 0.08 293);
  --status-hold-ring: oklch(0.85 0.05 295);
  --status-hold-dot: oklch(0.6 0.13 295);

  --status-transit: oklch(0.93 0.04 214);
  --status-transit-foreground: oklch(0.4 0.06 228);
  --status-transit-ring: oklch(0.83 0.05 214);
  --status-transit-dot: oklch(0.6 0.12 214);

  /* kpi-card trends (UX-0006 §1.5: 7.87-10.87:1 ✅) — valor preservado. */
  --kpi-trend-info: oklch(0.38 0.06 240);
  --kpi-trend-success: oklch(0.35 0.07 160);
  --kpi-trend-warning: oklch(0.4 0.08 85);
  --kpi-trend-danger: oklch(0.45 0.12 22);

  /* module-card violet/cyan (UX-0006 §1.5: 5.73:1 / 6.41:1 ✅) — valor preservado. */
  --module-violet: oklch(0.88 0.06 295);
  --module-violet-foreground: oklch(0.43 0.08 293);
  --module-cyan: oklch(0.88 0.05 214);
  --module-cyan-foreground: oklch(0.4 0.06 228);

  --shadow-card:
    0 1px 0 0 color-mix(in oklch, var(--foreground) 4%, transparent),
    0 1px 2px -1px color-mix(in oklch, var(--foreground) 6%, transparent),
    0 8px 24px -18px color-mix(in oklch, var(--foreground) 22%, transparent);
  --shadow-soft:
    0 1px 0 0 color-mix(in oklch, var(--foreground) 5%, transparent),
    0 10px 30px -22px color-mix(in oklch, var(--foreground) 30%, transparent);
  --shadow-popover:
    0 1px 0 0 color-mix(in oklch, var(--foreground) 6%, transparent),
    0 12px 36px -16px color-mix(in oklch, var(--foreground) 28%, transparent),
    0 24px 64px -36px color-mix(in oklch, var(--foreground) 38%, transparent);
  --shadow-elevated:
    0 1px 0 0 color-mix(in oklch, var(--foreground) 7%, transparent),
    0 24px 56px -24px color-mix(in oklch, var(--foreground) 32%, transparent),
    0 48px 96px -42px color-mix(in oklch, var(--foreground) 46%, transparent);
}

@layer base {
  * {
    @apply border-border;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in oklch, var(--border-strong) 38%, transparent) transparent;
  }

  *::-webkit-scrollbar {
    width: 11px;
    height: 11px;
  }

  *::-webkit-scrollbar-track {
    background: transparent;
  }

  *::-webkit-scrollbar-thumb {
    border-radius: 999px;
    border: 2px solid transparent;
    background-clip: padding-box;
    background-color: color-mix(in oklch, var(--border-strong) 42%, transparent);
  }

  *::-webkit-scrollbar-thumb:hover {
    background-color: color-mix(in oklch, var(--border-strong) 60%, transparent);
  }

  body {
    @apply bg-canvas text-foreground font-sans;
    background-image:
      radial-gradient(circle at 6% 8%, color-mix(in oklch, var(--accent) 24%, transparent) 0%, transparent 40%),
      radial-gradient(circle at 96% -2%, color-mix(in oklch, var(--primary) 20%, transparent) 0%, transparent 36%);
    background-attachment: fixed;
    line-height: 1.55;
    font-feature-settings: "ss01", "cv11", "cv02";
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: var(--font-heading), sans-serif;
    line-height: 1.15;
  }

  h1 {
    letter-spacing: -0.028em;
  }

  h2 {
    letter-spacing: -0.022em;
  }

  h3 {
    letter-spacing: -0.018em;
  }

  h4,
  h5,
  h6 {
    letter-spacing: -0.014em;
  }

  ::selection {
    background: color-mix(in oklch, var(--accent) 50%, white);
    color: var(--foreground);
  }
}

@layer utilities {
  .scroll-modern {
    scrollbar-gutter: stable both-edges;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    font-size: 0.6875rem;
    color: var(--muted-foreground);
  }

  .accent-rule {
    background-image: linear-gradient(
      90deg,
      color-mix(in oklch, var(--primary) 60%, transparent) 0%,
      color-mix(in oklch, var(--accent) 70%, transparent) 50%,
      color-mix(in oklch, var(--accent) 0%, transparent) 100%
    );
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}
