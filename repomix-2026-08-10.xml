      setIsSubmitting(true);

      try {
        const created = await readJson<CreateMasterClientResult>("/api/master/clients", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(payload),
        });

        await refresh();
        return created;
      } finally {
        setIsSubmitting(false);
      }
