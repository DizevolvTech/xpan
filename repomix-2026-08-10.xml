  const notReleased = applyFactoryWorkflowState(buildPlanning(), {
    isReleased: () => false,
    isCancelled: () => false,
    resolveProductionItemStatus: () => "nao_iniciado",
    isProductionStarted: () => true,
  });
  assert.equal(notReleased.orderItems[0]?.productionStarted, false);
});

