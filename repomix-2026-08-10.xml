export const MASTER_CLIENT_ADMIN_EMAIL_CONFLICT_MESSAGE =
  "Este e-mail já está em uso por outro usuário. Troque o e-mail do administrador inicial para concluir o cadastro.";

export type MasterClientMetrics = {
  users: number;
  activeUsers: number;
