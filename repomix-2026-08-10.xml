  // Liberado E iniciado pelo gestor, ainda nao_iniciado → entra no chão (1ª coluna).
  const started = applyFactoryWorkflowState(buildPlanning(), {
    isReleased: () => true,
    isCancelled: () => false,
    resolveProductionItemStatus: () => "nao_iniciado",
    isProductionStarted: () => true,
