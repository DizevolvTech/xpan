  <article                            o card
    data-slot="data-card"
    className={cn(
      "rounded-lg border border-border/[var(--opacity-strong)] bg-card p-rhythm-sm shadow-[var(--shadow-card)]",
      rowExpanded && "border-l-2 border-l-primary bg-primary/[var(--opacity-faint)]",
      rowClickable && "cursor-pointer",
