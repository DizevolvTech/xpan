import {
  defaultRecipeStage,
  hierarchyLabels,
  productionWeekDays,
  recipeStageLabels,
  recipeStages,
  type BreakStage,
  type IngredientCompositionItem,
  type PackagingProfile,
  type ProductUnitProfile,
