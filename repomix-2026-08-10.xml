          {subtitle && <p className="mt-0.5 text-xs text-muted-foreground">{subtitle}</p>}
        </div>
      </div>

      <p className="mt-4 text-sm text-muted-foreground">{description}</p>

      {items && items.length > 0 && (
        <ul className="mt-4 space-y-1.5">
          {items.map((item) => (
