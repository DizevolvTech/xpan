  try {
    const { searchParams } = new URL(request.url);
    const storeId = searchParams.get("storeId");
    const orderedAt = searchParams.get("orderedAt");
    // AJ-A10: opcional. Quando a loja preenche um pedido aberto p/ data futura, a UI
