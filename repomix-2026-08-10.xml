  if (legacyResult.data) {
    return legacyResult.data.id;
  }

  if (!isUuid(identifier)) {
    throw new Error("products not found");
  }

  const idResult = await supabase.from("products").select("id").eq("id", identifier).maybeSingle();
  if (idResult.error) {
