                        )}
                      </div>
                    </td>
                    <td className="border-t border-border/70 bg-card px-4 py-3 text-sm">{item.sourceItemsCount}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </PaginatedSection>
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle>Pedidos atendidos por esta OP</CardTitle>
